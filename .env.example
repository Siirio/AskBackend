# Database
ASK_DB_URL=jdbc:postgresql://localhost:5432/ask
ASK_DB_NAME=ask
ASK_DB_USERNAME=postgres
ASK_DB_PASSWORD=change-me

# Server
ASK_SERVER_PORT=8080

# Auth
AUTH_JWT_SECRET=change-me-in-production-use-at-least-256-bits
AUTH_CHALLENGE_TTL=300
AUTH_VERIFICATION_EMAIL_ENABLED=true
AUTH_VERIFICATION_SMS_ENABLED=false
# Set to true for local/staging to show code in UI instead of sending
AUTH_VERIFICATION_STAGING_BYPASS=false
AUTH_STAFF_TEMP_PASSWORD_KEY=change-me-in-production-32chr

# Mail
ASK_MAIL_HOST=smtp.gmail.com
ASK_MAIL_PORT=587
ASK_MAIL_USERNAME=
ASK_MAIL_PASSWORD=
AUTH_EMAIL_FROM=noreply@ask.kz

# CORS
ASK_CORS_ORIGINS=http://localhost:5173

# AI structured search
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_SEARCH_MAX_TOKENS=1800
DEEPSEEK_AUTODUMP_MODEL=deepseek-v4-flash
DEEPSEEK_AUTODUMP_MAX_TOKENS=4000

# Session TTL (seconds)
AUTH_CUSTOMER_SESSION_TTL=86400
AUTH_CUSTOMER_REMEMBERED_SESSION_TTL=2592000
AUTH_BUSINESS_SESSION_TTL=86400
AUTH_BUSINESS_REMEMBERED_SESSION_TTL=2592000
AUTH_STAFF_SESSION_TTL=86400
AUTH_STAFF_REMEMBERED_SESSION_TTL=2592000
AUTH_STAFF_ACTIVATION_SESSION_TTL=300
